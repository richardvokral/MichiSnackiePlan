# Neon Postgres — set via Vercel Marketplace integration
DATABASE_URL=postgres://user:pass@host/dbname

# Bootstrap admin — always has admin access even without being in the admins table
FIRST_ADMIN_EMAIL=richard.vokral@gmail.com

# Admin gate. Production ALWAYS enforces Logto admin sign-in for /admin,
# regardless of this flag. In dev, "false" keeps the no-sign-in pass-through;
# set "true" to test real enforcement locally.
AUTH_ENABLED=false

# Vercel Blob — must be a PUBLIC store (meal photos are shown to all visitors)
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxx

# Anthropic — powers AI generation of ingredients + foods (model is admin-configurable
# under /admin/ai/settings; defaults to claude-opus-4-8).
ANTHROPIC_API_KEY=sk-ant-xxx

# USDA FoodData Central — ingredient nutrition lookup. Free key:
# https://fdc.nal.usda.gov/api-key-signup
USDA_API_KEY=xxx

# Logto Cloud (https://logto.io) — enables user sign-in + multi-day plans + preferences.
# Leave blank to run the app fully anonymous (today-only, localStorage).
# In the Logto app settings, set:
#   Redirect URI:            ${LOGTO_BASE_URL}/callback
#   Post sign-out redirect:  ${LOGTO_BASE_URL}
LOGTO_ENDPOINT=https://xxxx.logto.app/
LOGTO_APP_ID=
LOGTO_APP_SECRET=
LOGTO_BASE_URL=https://your-app.vercel.app
# Random 32+ char string, e.g. `openssl rand -base64 32`
LOGTO_COOKIE_SECRET=
